---
import { Image } from 'astro:assets';
import stretchImage from '../assets/images/2f-upandstretch.jpg';
import ringImage from '../assets/images/3f-ringandsandbagspace.jpg';
import machinesImage from '../assets/images/2f-trainingmachinespace.jpg';

const spaces = [
  { image: stretchImage, label: '2F　アップアンドストレッチスペース', alt: '青いマットの上でストレッチをする人たち' },
  { image: ringImage, label: '3F　大型リングアンドサンドバッグスペース', alt: '大型リングと奥のサンドバッグで練習する人たち' },
  { image: machinesImage, label: '2F　トレーニングマシーンスペース', alt: 'マシーンを使って筋力トレーニングをする人' },
];
---
<section class="photo-story" aria-labelledby="story-title">
  <div class="wrap story-heading" data-reveal=""><div><p class="eyebrow">FEEL THE BOXING.</p><h2 id="story-title">夢中になれる、<br class="mobile-only" />その瞬間。</h2></div><p>一打ずつ、自分らしく。<br />ボクシングのある毎日へ。</p></div>
  <div id="story-viewport" class="story-viewport" tabindex="0" role="region" aria-label="ジムの施設写真。左右にスクロールできます。">
    <div class="story-track">
      {spaces.map(space => (
        <figure class="story-card">
          <Image
            class="story-image"
            src={space.image}
            alt={space.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 760px) 81vw, (max-width: 1060px) min(78vw, 620px), clamp(620px, 58vw, 720px)"
            loading="lazy"
          />
          <figcaption>{space.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
  <div class="story-controls" hidden>
    <button type="button" class="story-arrow" data-step="-1" aria-label="前の写真" aria-controls="story-viewport"></button>
    <div class="story-dots" role="group" aria-label="表示する写真を選ぶ">
      {spaces.map((space, index) => (
        <button
          type="button"
          class="story-dot"
          aria-label={space.label}
          aria-controls="story-viewport"
          aria-current={index === 0 ? 'true' : undefined}
        ></button>
      ))}
    </div>
    <button type="button" class="story-arrow" data-step="1" aria-label="次の写真" aria-controls="story-viewport"></button>
  </div>
</section>
<script>
  import '../scripts/training-gallery';
</script>
